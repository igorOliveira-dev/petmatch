# Copie para .env (só para rodar sem Docker)
DATABASE_URL=postgres://usuario:senha@localhost:5432/petmatch
SEGREDO=troque-por-um-texto-longo-e-aleatorio
ADMIN_SENHA=admin123
PORT=3000
# Endereço público do site (usado nos links dos e-mails)
SITE_URL=https://petmatch.bitemenu.com.br
# Servidor de e-mail (sem isso, os e-mails só aparecem no console e o link de confirmação aparece na tela)
# Ex. Gmail com "senha de app": smtps://seuemail%40gmail.com:senhadeapp@smtp.gmail.com:465
SMTP_URL=
EMAIL_REMETENTE=PetMatch <seuemail@gmail.com>
